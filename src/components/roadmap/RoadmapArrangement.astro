---
// The roadmap as an arrangement (spec §6): a quarter ruler, three tracks with
// positioned span clips, a playhead, a legend, and a date-ordered mobile graph.
// Positions are computed at build time for the default "span" window with the
// shared timeline math (as the home Timeline.astro does); the arrangement script
// (src/scripts/roadmap-arrangement.ts) re-lays them for the "All" zoom in the
// browser, reading the clip list embedded as JSON in #rm-clip-data.
import { roadmapClips, roadmapWindow, quarterTicks, STATUS_WORDS, type RoadmapClip, type Track } from "../../lib/roadmap/arrange";
import { positionIn, packRows, estimateLabelWidth, fraction } from "../../lib/timeline/layout";
import { monthDayYear, monthYear } from "../../lib/dates";

const now = new Date();
// Zeroed: the saved progress lives behind /api/progress and is not available at
// build time, so every count and status below is a PLACEHOLDER that
// src/scripts/roadmap.ts overwrites on load through the data-clip-* hooks. It is
// not the still frame the rest of the site server-renders — it is wrong until
// the script runs — so the numbers, the status classes and the spoken status
// words all carry a hook. Positions are real and are never rewritten from here.
const clips = roadmapClips(new Set<string>(), now);
const win = roadmapWindow("span", now, clips);
const ticks = quarterTicks(win);
const estimate = estimateLabelWidth();
const nowX = fraction(now, win); // 0..1 within the window

// Spec §9: the "All" zoom is only worth showing once a clip falls outside the
// default window. While they are the same window the control is a no-op, so it
// is not rendered at all and the script no-ops with it.
const allWin = roadmapWindow("all", now, clips);
const showZoom =
  allWin.from.getTime() !== win.from.getTime() || allWin.to.getTime() !== win.to.getTime();
// Derived from the window itself, not a literal -- a hardcoded "2026–2027" is
// exactly what drifted out of sync when the default window was resized to
// Jul 2026 – Jun 2027 (Task: size the default window to the plan). This
// control is currently never rendered (showZoom is false, spec §9), so the
// drift was latent, but the label must not go stale the day it returns.
const spanLabel = `${monthYear(win.from)} – ${monthYear(win.to)}`;

const TRACKS: { key: Track; label: string; note: string }[] = [
  { key: "build", label: "Build", note: "CodeCrafters, in order" },
  { key: "reading", label: "Reading", note: "anchor + light" },
  { key: "foundations", label: "Foundations", note: "NeetCode" },
];

// Per track: position its clips in the window, then pack into rows.
// packRows returns RowPlaced<RoadmapClip>[] — each has .item (the clip), .x, .w, .row.
const lanes = TRACKS.map((t) => {
  const placed = clips.filter((c) => c.track === t.key).flatMap((c) => positionIn(c, win, now) ?? []);
  const rows = packRows(placed, estimate);
  // The lane grows with its packed rows rather than sitting at a fixed height,
  // so a third row is drawn instead of overflowing (spec §9).
  const rowCount = rows.reduce((max, p) => Math.max(max, p.row + 1), 1);
  return { ...t, rows, rowCount };
});

// Mobile graph rows: every clip in start-date order, with a "now" boundary
// inserted before the first clip that starts after now (as the home graph draws
// its now line). A trailing `now` lands last when every clip has already begun.
type GraphEntry = { kind: "now" } | { kind: "clip"; clip: RoadmapClip };
const byStart = [...clips].sort((a, b) => a.start.getTime() - b.start.getTime());
const firstFuture = byStart.findIndex((c) => c.start.getTime() > now.getTime());
const nowAt = firstFuture === -1 ? byStart.length : firstFuture;
const graphEntries: GraphEntry[] = [
  ...byStart.slice(0, nowAt).map((clip) => ({ kind: "clip" as const, clip })),
  { kind: "now" as const },
  ...byStart.slice(nowAt).map((clip) => ({ kind: "clip" as const, clip })),
];

// Serialize for the client script so it can re-lay for the "All" zoom.
const clipData = clips.map((c) => ({
  id: c.id, track: c.track, title: c.title, sublabel: c.sublabel,
  start: c.start.toISOString(), end: c.end.toISOString(), status: c.status, href: c.href,
}));
---

{/* Above the arrangement and outside it, because the arrangement is hidden
    below 900px while edit mode still works on the mobile graph. The ids here
    are a contract with src/scripts/roadmap.ts — do not rename them. */}
<div class="rm-toolbar">
  {showZoom && (
    <div class="rm-zoom" role="group" aria-label="Zoom">
      <button type="button" data-rm-zoom="span" aria-pressed="true">{spanLabel}</button>
      <button type="button" data-rm-zoom="all" aria-pressed="false">All</button>
    </div>
  )}
  <span id="rm-save-state" class="rm-save-state" role="status" aria-live="polite"></span>
  <button id="rm-edit" type="button" class="rm-edit-btn">Edit</button>
</div>
<p id="rm-message" class="rm-message" role="alert" aria-live="assertive" hidden></p>

{/* Ticking a checkbox silently rewrites clip counts and status fills that a
    sighted reader watches change and a screen-reader user cannot. This is the
    spoken half of that repaint (the sentence itself is progressAnnouncement in
    src/lib/roadmap/arrange.ts). It is server-rendered empty so the region is
    already in the accessibility tree when the first edit writes into it, and it
    sits outside .rm-arr, which is display:none below 900px — edit mode works at
    every width, so its announcements must too. */}
<p id="rm-clip-live" class="sr-only" role="status" aria-live="polite"></p>

<div class="rm-arr">
  <div class="rm-arr-body">
    <div class="rm-ruler" aria-hidden="true">
      {ticks.map((t) => <span class="rm-tick" style={`left:${t.x * 100}%`}>{t.label}</span>)}
    </div>

    {lanes.map((lane) => (
      <div class="rm-lane" style={`--c: var(--track-${lane.key}); --rows: ${lane.rowCount}`}>
        <div class="rm-lane-head">
          {/* The #rm-track-* anchors live on the meters (RoadmapMeters.astro),
              which are visible at every width; this arrangement is hidden below
              900px, so an id here would strand /roadmap#rm-track-* on phones. */}
          <h2><i class="rm-mdot"></i>{lane.label}</h2>
          <small>{lane.note}</small>
        </div>
        {/* A list, as the home Timeline's .tl-items is: the clips are a set of
            peers, and a screen reader should hear how many. The <li> stays a
            zero-height static box and the <a class="rm-clip"> keeps the absolute
            positioning, so src/scripts/roadmap-arrangement.ts still writes
            --x/--w/--y to .rm-clip[data-clip-id]. */}
        <ol class="rm-clips" data-track={lane.key} role="list">
          {lane.rows.map((p) => (
            <li class="rm-clip-item">
              <a
                class:list={["rm-clip", `is-${p.item.status}`]}
                href={p.item.href}
                data-clip-id={p.item.id}
                style={`--x:${p.x * 100}%; --w:${p.w * 100}%; --y:${p.row}`}
              >
                <span class="rm-clip-title">{p.item.title}</span>
                {p.item.sublabel && <small class="rm-clip-sub" data-clip-sub={p.item.id}>{p.item.sublabel}</small>}
                <span class="sr-only">, <span data-clip-status={p.item.id}>{STATUS_WORDS[p.item.status]}</span></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}

    <div class="rm-playhead" style={`--ph:${nowX}`} data-rm-playhead><span>now</span></div>
  </div>
</div>

{/* Mobile graph: the same clips, date-ordered, shown below 900px (spec §6). */}
<ol class="rm-graph" role="list" aria-label="Roadmap, by date">
  {graphEntries.map((e) =>
    e.kind === "now" ? (
      <li class="rm-graph-now"><span>now · {monthDayYear(now)}</span></li>
    ) : (
      <li class:list={["rm-graph-row", `t-${e.clip.track}`, `is-${e.clip.status}`]} data-clip-id={e.clip.id}>
        <a href={e.clip.href}>
          <b>{e.clip.title}</b>
          <small data-clip-sub={e.clip.id}>{e.clip.sublabel}</small>
          <span class="sr-only">, <span data-clip-status={e.clip.id}>{STATUS_WORDS[e.clip.status]}</span></span>
        </a>
      </li>
    ),
  )}
</ol>

<script type="application/json" id="rm-clip-data" set:html={JSON.stringify(clipData).replace(/</g, "\\u003c")}></script>

<div class="rm-legend" aria-hidden="true">
  <span><i class="l-done"></i>done</span>
  <span><i class="l-prog"></i>in progress</span>
  <span><i class="l-plan"></i>planned</span>
</div>
