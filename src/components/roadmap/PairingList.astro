---
// One phase's reading or foundations list (spec §8). Rows are grouped by their
// book or foundations group, so a book that carries seven chapters prints its
// title once instead of seven times — the flat version of this list was the
// single biggest reason the this-week band read as a wall of text.
//
// Every string here comes from src/lib/roadmap/pairings.ts, which is unit
// tested; this file only lays them out.
import { groupPairings } from "../../lib/roadmap/pairings";
import type { Pairing } from "../../data/roadmap";

interface Props {
  label: string;
  items: Pairing[];
}
const { label, items } = Astro.props;
const groups = groupPairings(items);
---

{groups.length > 0 && (
  <section class="rm-pairs" data-pairing-list>
    <p class="rm-pairs-k">{label}</p>
    {groups.map((g) => (
      <div class="rm-pairs-g">
        <p class="rm-pairs-gt">{g.title}</p>
        {/* No aria-label: the visible group title sits immediately above the
            list, so labelling it again only duplicates the text. */}
        <ul>
          {g.rows.map((r) => (
            <li class:list={[{ optional: r.optional }]}>
              <span class="rm-pairs-t">{r.label}</span>
              {(r.count || r.note) && (
                <small>
                  {r.count && <span class="rm-pairs-c">{r.count}</span>}
                  {r.count && r.note && <span class="rm-pairs-sep">·</span>}
                  {r.note}
                </small>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}
