---
// src/components/RightNow.astro
// The hero's "Right now" readout (interactions 2): one row per lane that has
// something touching the build day, from rightNow(). Renders nothing when no
// lane does. Each entry's link mirrors its clip (the item's own href plus
// data-item-link), so with JavaScript it opens the inspector and without it
// the essay or case study loads. A phrase follows the entry only when it is
// alone in its row; the others render `hidden`, and src/scripts/timeline/now.ts
// prunes entries that no longer touch the real day and unhides a phrase left
// alone. Nothing is created on the client, so the styles stay scoped.
import type { TimelineItem } from "../lib/timeline/types";
import { nowText, rightNow } from "../lib/timeline/now";

interface Props {
  items: TimelineItem[];
  now: Date;
}

const { items, now } = Astro.props;
const rows = rightNow(items, now);
const laneName = (lane: string) => lane[0].toUpperCase() + lane.slice(1);
---

{rows.length > 0 && (
  <section class="now" data-right-now aria-labelledby="right-now-k">
    <p class="now-k" id="right-now-k"><i aria-hidden="true"></i>Right now</p>
    <dl class="now-rows">
      {rows.map((row) => (
        <div class="now-row" data-now-row={row.lane} style={`--c: var(--lane-${row.lane})`}>
          <dt><i aria-hidden="true"></i>{laneName(row.lane)}</dt>
          {row.entries.map((item) => (
            <dd data-id={item.id}><a href={item.href} data-item-link={item.id} data-astro-prefetch="false">{item.title}</a><small data-now-when hidden={row.entries.length > 1}>{nowText(item)}</small></dd>
          ))}
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .now {
    --dt: 7.8em;
    margin-top: 22px;
    font-size: 15px;
    line-height: 1.5;
  }
  .now-k {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .now-k i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-text-primary);
  }
  .now-rows {
    display: grid;
    gap: 4px;
    margin: 0;
  }
  /* A hanging indent: the lane name takes the first --dt of every row and a
     wrapped title continues under the first title, not under the name. */
  .now-row {
    padding-left: var(--dt);
    text-indent: calc(-1 * var(--dt));
  }
  .now-row dt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: var(--dt);
    text-indent: 0;
    vertical-align: baseline;
    font-weight: 500;
    color: var(--c);
  }
  .now-row dt i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--c);
  }
  .now-row dd {
    display: inline;
    margin: 0;
  }
  /* Entries in one row read as a list; the separators live here so the client
     prune never has to re-join them. */
  .now-row dd + dd::before {
    content: ", ";
    color: var(--color-text-secondary);
  }
  .now-row dd + dd:last-of-type::before {
    content: " and ";
  }
  .now-row a {
    color: var(--color-text-primary);
    padding-bottom: 1px;
    border-bottom: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    transition: border-color var(--transition-fast);
  }
  .now-row a:hover {
    border-color: var(--c);
  }
  .now-row small {
    margin-left: 0.45em;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  @media (max-width: 899.98px) {
    .now {
      margin-top: 16px;
      font-size: 13.5px;
    }
    .now-row small {
      font-size: 12px;
    }
  }
</style>
